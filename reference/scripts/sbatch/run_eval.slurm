#!/bin/bash
#SBATCH --job-name=privasis_eval
#SBATCH --partition=gpu
#SBATCH --gpus=1
#SBATCH --constraint="gh200|h100|a100|a40|l40s|rtx8000"
#SBATCH --qos=short
#SBATCH --time=04:00:00
#SBATCH --mem=50G
#SBATCH --output=logs/eval_%j.out
#SBATCH --error=logs/eval_%j.err

# Load environment
module load conda/latest
conda activate latent-lang-diff

# Create logs directory if it doesn't exist
mkdir -p logs

echo "Starting Metrics Evaluation..."
# Note: This expects an 'inference_results.json' file generated by the inference script or trainer
python evaluation/custom_metrics.py
echo "Done."
